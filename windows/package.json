{
  "name": "coucou-windows",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "icons": "node scripts/gen-icons.mjs",
    "tauri": "tauri",
    "predev": "cargo build --release -p coucou-hook",
    "prebuild": "cargo build --release -p coucou-hook",
    "pack": "tauri build && node scripts/pack.mjs",
    "test": "npm run test:rust && npm run test:unit",
    "test:rust": "cargo build --release -p coucou-hook && cargo test --workspace",
    "test:unit": "tsc -p tests && vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.19.0",
    "typescript": "^5.6.0",
    "vite": "^6",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  }
}
