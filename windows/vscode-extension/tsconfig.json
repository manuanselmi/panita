{
  // Compiles the extension to CommonJS in out/, which is what VS Code loads.
  // Built with the TypeScript of the windows/ package (npm run build:extension);
  // the extension itself has no dependencies of its own.
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "outDir": "out",
    "rootDir": "src",
    "types": ["node", "vscode"]
  },
  "include": ["src"]
}
